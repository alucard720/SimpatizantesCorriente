NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://corriente:local-development-only@localhost:5432/corriente?schema=public
FRONTEND_ORIGIN=http://localhost:5173
# Generar cada clave por separado: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
CEDULA_HMAC_KEY=
CAPTCHA_PROVIDER=disabled
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
TRUST_PROXY_HOPS=0
PRIVACY_VERSION=2026-01
PRIVACY_CONTROLLER=Configurar responsable antes de publicar
PRIVACY_CONTACT=Configurar contacto antes de publicar
PRIVACY_RETENTION=Configurar plazo y procedimiento de supresión antes de publicar

# Opcionales; solo los utiliza el comando explícito npm run admin:dev.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
