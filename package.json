{
  "name": "corriente-v1",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "db:seed": "npm run db:seed -w backend",
    "admin:create": "npm run admin:create -w backend",
    "admin:dev": "npm run admin:dev -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0"
  }
}
